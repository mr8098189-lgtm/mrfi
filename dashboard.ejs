<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MrFi Admin</title><link rel="stylesheet" href="/style.css"></head><body><nav><div class="brand">Mr<span>Fi</span> <small>ADMIN</small></div><form method="post" action="/admin/logout"><button class="ghost">Logout</button></form></nav><main class="admin">
<div class="stats"><div><b><%= counts.total||0 %></b><span>Total</span></div><div><b><%= counts.new_count||0 %></b><span>New</span></div><div><b><%= counts.review_count||0 %></b><span>Under Review</span></div><div><b><%= counts.approved_count||0 %></b><span>Approved</span></div><div><b>₹<%= Number(counts.total_amount||0).toLocaleString("en-IN") %></b><span>Total Requested</span></div></div>
<div class="tablecard"><h2>Application Analytics — Last 6 Months</h2><table><thead><tr><th>Month</th><th>Applications</th><th>Requested Amount</th></tr></thead><tbody><% monthly.forEach(m=>{ %><tr><td><%= m.month %></td><td><%= m.applications %></td><td>₹<%= Number(m.amount).toLocaleString("en-IN") %></td></tr><% }) %></tbody></table></div>
<div class="tablecard"><h2>Customer Applications</h2><div class="tablewrap"><table><thead><tr><th>ID</th><th>Customer</th><th>Loan</th><th>Amount</th><th>Status</th><th>Aadhaar</th><th>PAN</th><th>Video KYC</th><th>Document</th></tr></thead><tbody>
<% apps.forEach(a=>{ %><tr><td><b><%= a.application_no %></b></td><td><%= a.name %><br><small><%= a.phone %></small></td><td><%= a.loan_type %></td><td>₹<%= Number(a.amount).toLocaleString("en-IN") %></td><td><form method="post" action="/admin/application/<%= a.id %>/status"><select name="status" onchange="this.form.submit()"><% ["New","Under Review","Approved","Rejected"].forEach(s=>{ %><option <%= a.status===s?"selected":"" %>><%= s %></option><% }) %></select></form></td><td><%= a.aadhaar_status %></td><td><%= a.pan_status %></td><td><form method="post" action="/admin/application/<%= a.id %>/kyc"><button class="smallbtn">Schedule</button></form></td><td><%= a.document_path?`<a href="${a.document_path}" target="_blank">View</a>`:"—" %></td></tr><% }) %></tbody></table></div></div>
</main></body></html>