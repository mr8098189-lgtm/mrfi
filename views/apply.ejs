<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Apply — MrFi</title><link rel="stylesheet" href="/style.css"></head><body><div class="formwrap"><a href="/" class="back">← MrFi</a><div class="formcard"><div class="pill">DIGITAL LOAN APPLICATION</div><h1>Apply in a few steps</h1><% if(error){ %><div class="error"><%= error %></div><% } %>
<div class="otpbox"><h3>1. Verify mobile number</h3><div class="row"><input id="phone" placeholder="10-digit mobile number"><button type="button" class="smallbtn" onclick="sendOtp()">Send OTP</button></div><div class="row"><input id="otp" placeholder="6-digit OTP"><button type="button" class="smallbtn" onclick="verifyOtp()">Verify</button></div><div id="otpmsg"></div></div>
<form id="appForm" method="post" action="/apply" enctype="multipart/form-data" onsubmit="document.querySelector('[name=phone]').value=document.getElementById('phone').value">
<div class="grid"><label>Full Name<input name="name" required></label><label>Mobile Number<input name="phone" required readonly></label><label>Email<input type="email" name="email"></label><label>Loan Type<select name="loan_type" required><option value="">Select</option><option>Personal</option><option>Business</option></select></label><label>Required Amount (₹)<input type="number" name="amount" min="1000" required></label><label>Monthly Income (₹)<input type="number" name="monthly_income" min="0"></label><label>Employment / Business Type<input name="employment"></label><label>Address<input name="address"></label></div>
<label>Message / Requirement<textarea name="message" rows="4"></textarea></label>
<label>Document (PDF/JPG/PNG, max 5MB)<input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png"></label>
<div class="consent"><input type="checkbox" required> I consent to MrFi contacting me about this application and processing the information submitted for application handling.</div>
<button id="submitBtn" class="btn big" type="submit" disabled>Verify Mobile First</button></form></div></div>
<script>
async function sendOtp(){const phone=document.getElementById("phone").value; const r=await fetch("/otp/send",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({phone})}); const d=await r.json(); document.getElementById("otpmsg").textContent=d.message+(d.demoCode?` Demo OTP: ${d.demoCode}`:"");}
async function verifyOtp(){const phone=document.getElementById("phone").value,code=document.getElementById("otp").value; const r=await fetch("/otp/verify",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({phone,code})}); const d=await r.json(); document.getElementById("otpmsg").textContent=d.error||"Mobile verified."; if(d.ok){document.querySelector('[name=phone]').value=phone;document.getElementById("submitBtn").disabled=false;document.getElementById("submitBtn").textContent="Submit Application";}}
</script></body></html>
