<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Track — MrFi</title><link rel="stylesheet" href="/style.css"></head><body><div class="center"><div class="card track"><div class="brand">Mr<span>Fi</span></div><div class="pill">APPLICATION TRACKING</div><h1>Track your application</h1><% if(error){ %><div class="error"><%= error %></div><% } %><form method="post" action="/track"><label>Application Number<input name="application_no" placeholder="MRFI2026XXXXXX" required></label><label>Mobile Number<input name="phone" required></label><button class="btn big">Check Status</button></form><% if(result){ %><hr><p><b><%= result.name %></b> · <%= result.loan_type %> · ₹<%= Number(result.amount).toLocaleString("en-IN") %></p><div class="status"><strong><%= result.status %></strong><span>Video KYC: <%= result.video_kyc_status %></span></div><p>Last updated: <%= new Date(result.updated_at).toLocaleString("en-IN") %></p><% } %></div></div></body></html>
